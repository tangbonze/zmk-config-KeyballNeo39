/dts-v1/;
#include <nordic/nrf52840_qiaa.dtsi>
#include <common/nordic/nrf52840_uf2_boot_mode.dtsi>
#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

/ {
    model = "Keyball Neo";
    compatible = "yangxing,keyball_neo39";

    chosen {
        zephyr,code-partition = &code_partition;
        zephyr,sram = &sram0;
        zephyr,flash = &flash0;
        zmk,battery = &vbatt;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <12>;
        rows = <4>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4)                    RC(0,7)  RC(0,8) RC(0,9) RC(0,10) RC(0,11) 
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4)                    RC(1,7)  RC(1,8) RC(1,9) RC(1,10) RC(1,11) 
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4)                    RC(2,7)  RC(2,8) RC(2,9) RC(2,10) RC(2,11) 
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5)    RC(3,6) RC(3,7)                           RC(3,11)  
        >;
    };



 matrix_physical_layout: matrix_physical_layout {
 	 compatible = "zmk,physical-layout";
 	 display-name = "Keyball Neo";
 	
	 transform = <&default_transform>;
	 	keys  //                     w   h    x    y     rot    rx    ry
            = <&key_physical_attrs 100 100    0   50       0     0     0>
            , <&key_physical_attrs 100 100  100   25       0     0     0>
            , <&key_physical_attrs 100 100  200    0       0     0     0>
            , <&key_physical_attrs 100 100  300   25       0     0     0>
            , <&key_physical_attrs 100 100  400   45       0     0     0>
            , <&key_physical_attrs 100 100  900   45       0     0     0>
            , <&key_physical_attrs 100 100 1000   25       0     0     0>
            , <&key_physical_attrs 100 100 1100    0       0     0     0>
            , <&key_physical_attrs 100 100 1200   25       0     0     0>
            , <&key_physical_attrs 100 100 1300   50       0     0     0>
            , <&key_physical_attrs 100 100    0  150       0     0     0>
            , <&key_physical_attrs 100 100  100  125       0     0     0>
            , <&key_physical_attrs 100 100  200  100       0     0     0>
            , <&key_physical_attrs 100 100  300  125       0     0     0>
            , <&key_physical_attrs 100 100  400  145       0     0     0>
            , <&key_physical_attrs 100 100  900  145       0     0     0>
            , <&key_physical_attrs 100 100 1000  125       0     0     0>
            , <&key_physical_attrs 100 100 1100  100       0     0     0>
            , <&key_physical_attrs 100 100 1200  125       0     0     0>
            , <&key_physical_attrs 100 100 1300  150       0     0     0>
            , <&key_physical_attrs 100 100    0  250       0     0     0>
            , <&key_physical_attrs 100 100  100  225       0     0     0>
            , <&key_physical_attrs 100 100  200  200       0     0     0>
            , <&key_physical_attrs 100 100  300  225       0     0     0>
            , <&key_physical_attrs 100 100  400  245       0     0     0>
            , <&key_physical_attrs 100 100  900  245       0     0     0>
            , <&key_physical_attrs 100 100 1000  225       0     0     0>
            , <&key_physical_attrs 100 100 1100  200       0     0     0>
            , <&key_physical_attrs 100 100 1200  225       0     0     0>
            , <&key_physical_attrs 100 100 1300  250       0     0     0>
            , <&key_physical_attrs 100 100    0  350       0     0     0>
            , <&key_physical_attrs 100 100  100  325       0     0     0>
            , <&key_physical_attrs 100 100  200  300       0     0     0>
            , <&key_physical_attrs 100 100  350  350       0     0     0>
            , <&key_physical_attrs 100 100  530  250    1000 (-100) (-100)>
            , <&key_physical_attrs 100 100  710   50    2500 (-100) (-100)>
            , <&key_physical_attrs 100 100  450  730 (-2500) (-100) (-100)>
            , <&key_physical_attrs 100 100  760  530 (-1000) (-100) (-100)>
            , <&key_physical_attrs 100 100 1300  350       0     0     0>
            ;
  };

    vbatt: vbatt {
        compatible = "zmk,battery-voltage-divider";
				io-channels = <&adc 5>;
				output-ohms = <2000000>;
				full-ohms = <(2000000+ 806000)>;
    };
};

&adc {
    status = "okay";
};
&gpiote {
    status = "okay";
};

&gpio0 {
    status = "okay";
};

&gpio1 {
    status = "okay";
};

zephyr_udc0:&usbd {
		status = "okay";
};



&flash0 {
    /*
     * For more information, see:
     * http://docs.zephyrproject.org/latest/devices/dts/flash_partitions.html
     */
    partitions {
        compatible = "fixed-partitions";
        #address-cells = <1>;
        #size-cells = <1>;

        sd_partition: partition@0 {
            reg = <0x00000000 0x00026000>;
        };
        code_partition: partition@26000 {
            reg = <0x00026000 0x000c6000>;
        };

        /*
         * The flash starting at 0x000ec000 and ending at
         * 0x000f3fff is reserved for use by the application.
         */

        /*
         * Storage partition will be used by FCB/LittleFS/NVS
         * if enabled.
         */
        storage_partition: partition@ec000 {
            reg = <0x000ec000 0x00008000>;
        };

        boot_partition: partition@f4000 {
            reg = <0x000f4000 0x0000c000>;
        };
    };
};

/ {
    // Trackball input listener. The sensor sits on the right half and the
    // right half is the central, so the ball is consumed locally, with no
    // split relay involved; keyball_neo39_right.dts attaches and enables it.
    trackball_listener: trackball_listener {
        compatible = "zmk,input-listener";
        status = "disabled";

        // The runtime input processors DYA Studio configures
        // (speed, rotation, axis snap, ...).
        input-processors = <&mouse_runtime_input_processor &scroll_runtime_input_processor>;

        // when the scroll layer is active, the trackball acts as a mouse wheel
        scroller {
            layers = <5>;
            input-processors = <&scroll_runtime_input_processor>;
        };

        // when the snipe layer is active, the trackball moves more slowly
        snipe {
            layers = <6>;
            input-processors = <&zip_xy_scaler 1 3 &mouse_runtime_input_processor>;
        };
    };

    // Trackball marker for the DYA Studio layout preview
    // (zmk-feature-module-physical-layout). Coordinates and size use the same
    // 0.01 unit scale as the key physical attributes above: the ball sits in
    // the gap between the two halves. Adjust if it looks off.
    trackball_layout: trackball_layout {
        compatible = "cormoran,physical-layout-trackball";
        display-name = "Trackball";
        size = <140>;
        x = <700>;
        y = <250>;

        linked-device-identifiers = "mouse", "scroll";
        linked-subsystems = "cormoran_rip", "cormoran_rip";
    };
};

// Must come after the matrix transform above: the runtime input processor
// definitions pull in dt-bindings/zmk/keys.h, which redefines RC(keycode) for
// modifiers and would otherwise clash with the RC(row, col) matrix macros.
#include <input/processors.dtsi>
#include <input/processors/runtime-input-processor.dtsi>
