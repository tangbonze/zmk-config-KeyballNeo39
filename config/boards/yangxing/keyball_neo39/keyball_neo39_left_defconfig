# SPDX-License-Identifier: MIT
#
# Peripheral (left) half: key matrix + nice!view display.
# The trackball lives on the right half, which is the central, so this half
# has no input device of its own.

# ---------------------------------------------------------------------------
# Board / SoC
# ---------------------------------------------------------------------------
CONFIG_ARM_MPU=y
CONFIG_MPU_ALLOW_FLASH_WRITE=y
CONFIG_PINCTRL=y
CONFIG_GPIO=y
CONFIG_SPI=y

# ---------------------------------------------------------------------------
# Transports
# ---------------------------------------------------------------------------
CONFIG_ZMK_USB=y
CONFIG_ZMK_BLE=y
CONFIG_ZMK_EXT_POWER=y

# ---------------------------------------------------------------------------
# Settings storage
# ---------------------------------------------------------------------------
CONFIG_USE_DT_CODE_PARTITION=y
CONFIG_BUILD_OUTPUT_UF2=y
CONFIG_NVS=y
CONFIG_SETTINGS_NVS=y
CONFIG_FLASH=y
CONFIG_FLASH_PAGE_LAYOUT=y
CONFIG_FLASH_MAP=y

# ---------------------------------------------------------------------------
# Display
# ---------------------------------------------------------------------------
CONFIG_ZMK_DISPLAY=y

# ---------------------------------------------------------------------------
# Battery reporting / deep sleep
# ---------------------------------------------------------------------------
CONFIG_ZMK_BATTERY_REPORTING=y
CONFIG_ZMK_BATTERY_REPORTING_FETCH_MODE_STATE_OF_CHARGE=y
CONFIG_ZMK_SLEEP=y
# 30 minutes
CONFIG_ZMK_IDLE_SLEEP_TIMEOUT=1800000

# ---------------------------------------------------------------------------
# Split relay plumbing, so settings edited in DYA Studio reach both halves.
# ---------------------------------------------------------------------------
CONFIG_ZMK_SPLIT_RELAY_EVENT=y
CONFIG_ZMK_SPLIT_RELAY_EVENT_DATA_LEN=240
CONFIG_ZMK_CUSTOM_SETTINGS=y
CONFIG_ZMK_CUSTOM_SETTINGS_SPLIT_RPC_RELAY=y
CONFIG_ZMK_SETTINGS_RPC=y
CONFIG_ZMK_SETTINGS_SAVE_DEBOUNCE=10000
CONFIG_ZMK_LOW_PRIORITY_THREAD_STACK_SIZE=2048

# Zephyr 4.1 enables the console by default; a keyboard does not need it.
CONFIG_CONSOLE=n
