# SPDX-License-Identifier: MIT
#
# Central (right) half: holds the USB/BLE link to the host, all ZMK Studio /
# DYA Studio RPC subsystems, and the PMW3610 trackball (which shares the SPI
# bus with the nice!view display).

# ---------------------------------------------------------------------------
# Board / SoC
# ---------------------------------------------------------------------------
CONFIG_ARM_MPU=y
CONFIG_MPU_ALLOW_FLASH_WRITE=y
CONFIG_PINCTRL=y
CONFIG_GPIO=y
CONFIG_SPI=y

# ---------------------------------------------------------------------------
# Transports
# ---------------------------------------------------------------------------
CONFIG_ZMK_USB=y
CONFIG_ZMK_BLE=y
CONFIG_ZMK_EXT_POWER=y

# ---------------------------------------------------------------------------
# Settings storage
# ---------------------------------------------------------------------------
CONFIG_USE_DT_CODE_PARTITION=y
CONFIG_BUILD_OUTPUT_UF2=y
CONFIG_NVS=y
CONFIG_SETTINGS_NVS=y
CONFIG_FLASH=y
CONFIG_FLASH_PAGE_LAYOUT=y
CONFIG_FLASH_MAP=y

# ---------------------------------------------------------------------------
# Display
# ---------------------------------------------------------------------------
CONFIG_ZMK_DISPLAY=y

# ---------------------------------------------------------------------------
# PMW3610 trackball (cormoran / DYA driver), local to this half
# ---------------------------------------------------------------------------
CONFIG_INPUT=y
CONFIG_ZMK_POINTING=y
CONFIG_PMW3610=y
CONFIG_PMW3610_REPORT_INTERVAL_MIN=8
CONFIG_PMW3610_INIT_POWER_UP_EXTRA_DELAY_MS=200
CONFIG_PMW3610_INVERT_X=n
CONFIG_PMW3610_INVERT_Y=y
CONFIG_PMW3610_SMART_ALGORITHM=y
CONFIG_ZMK_PMW3610_STUDIO_RPC=y
CONFIG_ZMK_PMW3610_CUSTOM_SETTINGS=y

# ---------------------------------------------------------------------------
# ZMK Studio
# ---------------------------------------------------------------------------
CONFIG_ZMK_STUDIO=y
CONFIG_ZMK_STUDIO_LOCKING=n

# ---------------------------------------------------------------------------
# DYA Studio (custom Studio RPC) support
# ---------------------------------------------------------------------------

# Trackball tab - runtime input processors (speed, rotation, layers)
CONFIG_ZMK_RUNTIME_INPUT_PROCESSOR=y
CONFIG_ZMK_RUNTIME_INPUT_PROCESSOR_STUDIO_RPC=y

# Connection tab - BLE profiles, OS detection and per-profile default layer
CONFIG_ZMK_BLE_MANAGEMENT=y
CONFIG_ZMK_BLE_MANAGEMENT_STUDIO_RPC=y
CONFIG_ZMK_OS_DETECTION=y
CONFIG_ZMK_OS_DETECTION_USB=y
CONFIG_ZMK_OS_DETECTION_BLE=y
CONFIG_ZMK_OS_DETECTION_STUDIO_RPC=y
CONFIG_ZMK_DEFAULT_LAYER=y
CONFIG_ZMK_DEFAULT_LAYER_MIN_INDEX=0
CONFIG_ZMK_DEFAULT_LAYER_MAX_INDEX=6
CONFIG_ZMK_DEFAULT_LAYER_STUDIO_RPC=y
CONFIG_ZMK_DEFAULT_LAYER_OS_DETECTION=y

# Settings tab - sleep/idle timeouts and typed custom settings
CONFIG_ZMK_SETTINGS_RPC=y
CONFIG_ZMK_SETTINGS_RPC_STUDIO=y
CONFIG_ZMK_CUSTOM_SETTINGS=y
CONFIG_ZMK_CUSTOM_SETTINGS_SPLIT_RPC_RELAY=y
CONFIG_ZMK_CUSTOM_SETTINGS_STUDIO_RPC=y

# Keymap tab - trackball node in the layout preview
CONFIG_ZMK_PHYSICAL_LAYOUTS_FEATURE=y
CONFIG_ZMK_PHYSICAL_LAYOUTS_FEATURE_STUDIO_RPC=y

# Keymap tab - runtime macros, played with &rmacro <slot>
CONFIG_ZMK_RUNTIME_MACRO=y
CONFIG_ZMK_RUNTIME_MACRO_STUDIO_RPC=y
# Identify behaviors by their CRC16 hash: stable local IDs across reboots
# without spending settings storage.
CONFIG_ZMK_BEHAVIOR_LOCAL_ID_TYPE_CRC16=y

# Keymap tab - runtime combos. No combo is defined in the keymap, so nothing
# changes until slots are created in DYA Studio; compile-time defaults can be
# declared with a "cormoran,runtime-combo-defaults" node if wanted.
CONFIG_ZMK_RUNTIME_COMBO=y
CONFIG_ZMK_RUNTIME_COMBO_STUDIO_RPC=y

# Diagnostics tab
CONFIG_ZMK_DEVICE_INFO=y
CONFIG_ZMK_DEVICE_INFO_STUDIO_RPC=y
CONFIG_ZMK_WATCHDOG=y
CONFIG_ZMK_WATCHDOG_STUDIO_RPC=y

# Battery history (Settings/diagnostics tabs)
CONFIG_ZMK_BATTERY_REPORTING=y
CONFIG_ZMK_BATTERY_REPORTING_FETCH_MODE_STATE_OF_CHARGE=y
CONFIG_ZMK_SPLIT_BLE_CENTRAL_BATTERY_LEVEL_PROXY=y
CONFIG_ZMK_SPLIT_BLE_CENTRAL_BATTERY_LEVEL_FETCHING=y
CONFIG_ZMK_BATTERY_HISTORY=y
CONFIG_ZMK_BATTERY_HISTORY_STUDIO_RPC=y

# Deep sleep
CONFIG_ZMK_SLEEP=y
# 30 minutes
CONFIG_ZMK_IDLE_SLEEP_TIMEOUT=1800000

# Split relay, stacks and buffers: several custom RPC subsystems at once need
# more room than ZMK's defaults, otherwise the firmware can overflow a stack
# or drop a reply.
CONFIG_ZMK_SPLIT_RELAY_EVENT=y
CONFIG_ZMK_SETTINGS_SAVE_DEBOUNCE=10000
CONFIG_ZMK_SPLIT_BLE_CENTRAL_SPLIT_RUN_STACK_SIZE=768
CONFIG_ZMK_LOW_PRIORITY_THREAD_STACK_SIZE=4096
CONFIG_ZMK_STUDIO_RPC_RX_BUF_SIZE=256
CONFIG_ZMK_STUDIO_RPC_TX_BUF_SIZE=256
CONFIG_ZMK_STUDIO_RPC_CUSTOM_SUBSYSTEM_REQUEST_PAYLOAD_MAX_BYTES=256
CONFIG_ZMK_SPLIT_RELAY_EVENT_DATA_LEN=240
CONFIG_SYSTEM_WORKQUEUE_STACK_SIZE=4096
CONFIG_ZMK_STUDIO_RPC_THREAD_STACK_SIZE=6000
CONFIG_ZMK_CUSTOM_SETTINGS_LARGE_VALUE_MAX_SIZE=256

# Zephyr 4.1 enables the console by default; a keyboard does not need it.
CONFIG_CONSOLE=n

CONFIG_LOG_PROCESS_THREAD_STARTUP_DELAY_MS=4000
